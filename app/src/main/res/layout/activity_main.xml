<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ الشاشة الرئيسية ============ -->
        <LinearLayout
            android:id="@+id/home_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="18dp" />

            <!-- بطاقة الحالة -->
            <androidx.cardview.widget.CardView
                style="@style/Card"
                app:cardBackgroundColor="@color/card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tv_home_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/tv_home_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hint"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:id="@+id/tv_home_warn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:textColor="@color/warn" android:textSize="14sp"
                android:padding="12dp" android:background="@drawable/field_bg" android:layout_marginTop="8dp" />
            <Button android:id="@+id/btn_home_battery" style="@style/Secondary" android:visibility="gone"
                android:text="@string/fix_battery" />
            <Button android:id="@+id/btn_home_start" style="@style/Primary" android:text="@string/start_monitor" />
            <Button android:id="@+id/btn_home_stop" style="@style/Secondary" android:text="@string/stop_monitor" />
            <Button android:id="@+id/btn_home_close" style="@style/Danger" android:text="@string/close_app" />

            <View style="@style/Divider" />

            <Button android:id="@+id/btn_open_settings" style="@style/Secondary" android:text="@string/open_settings" />
            <Button android:id="@+id/btn_download_latest" style="@style/Secondary" android:text="@string/download_latest" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:textColor="@color/hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ============ الإعدادات (كل مجموعة تُفتح من زرها) ============ -->
        <LinearLayout
            android:id="@+id/settings_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="20dp">

            <!-- ======== شاشة ١: قائمة الأجهزة ======== -->
            <LinearLayout android:id="@+id/devices_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/devices_title" android:textColor="@color/text"
                        android:textSize="24sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_gear" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minWidth="56dp" android:text="⚙" android:textSize="22sp"
                        android:backgroundTint="@color/card" android:textColor="@color/text"
                        android:contentDescription="@string/app_settings_title" />
                </LinearLayout>
                <TextView style="@style/Hint" android:text="@string/devices_list_hint" />
                <LinearLayout android:id="@+id/ll_device_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <Button android:id="@+id/btn_refresh_devices" style="@style/Secondary" android:text="@string/refresh_devices" />
                <Button android:id="@+id/btn_close_settings" style="@style/Secondary" android:text="@string/logout" />
            </LinearLayout>

            <!-- ======== شاشة ٢: إعدادات الجهاز المختار ======== -->
            <LinearLayout android:id="@+id/device_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <Button android:id="@+id/btn_back_devices" style="@style/Secondary" android:text="@string/back_devices" />
                <TextView android:id="@+id/tv_device_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold"
                    android:gravity="center" android:paddingTop="10dp" android:paddingBottom="4dp" />
                <TextView android:id="@+id/tv_target_status" style="@style/Hint" />
                <TextView style="@style/FieldLabel" android:text="@string/current_setting_label" android:paddingTop="8dp" />
                <TextView android:id="@+id/tv_device_summary" style="@style/Status" />
                <TextView style="@style/FieldLabel" android:text="@string/actions_label" android:paddingTop="10dp" />
                <LinearLayout android:id="@+id/ll_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <Button android:id="@+id/btn_back_devices2" style="@style/Secondary" android:text="@string/back_devices" />
            </LinearLayout>

            <!-- ======== شاشة ٢ب: محرّر الإعداد (افتراضي أو لحظي) ======== -->
            <LinearLayout android:id="@+id/edit_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <Button android:id="@+id/btn_back_device" style="@style/Secondary" android:text="@string/back_device" />
                <TextView android:id="@+id/tv_edit_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"
                    android:gravity="center" android:paddingTop="10dp" android:paddingBottom="4dp" />

                <androidx.cardview.widget.CardView android:id="@+id/target_bar" style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/FieldLabel" android:text="@string/type_label" />
                        <RadioGroup android:id="@+id/rg_type"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:paddingTop="4dp">
                            <RadioButton android:id="@+id/rb_type_default" style="@style/Check" android:text="@string/type_default" />
                            <RadioButton android:id="@+id/rb_type_instant" style="@style/Check" android:text="@string/type_instant" />
                        </RadioGroup>
                        <LinearLayout android:id="@+id/instant_row"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:visibility="gone">
                            <TextView style="@style/FieldLabel" android:text="@string/instant_dur_label" />
                            <EditText android:id="@+id/et_instant_dur" style="@style/Num" android:hint="60" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            <!-- ===== المدد ===== -->
            <Button android:id="@+id/hdr_limits" style="@style/GroupHeader" android:text="@string/sec_limits" />
            <LinearLayout android:id="@+id/box_limits" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/FieldLabel" android:text="@string/presets_label" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <Button android:id="@+id/btn_p1" style="@style/Secondary"
                                android:layout_width="0dp" android:layout_weight="1" android:text="@string/preset_1" />
                            <Button android:id="@+id/btn_p10" style="@style/Secondary"
                                android:layout_width="0dp" android:layout_weight="1" android:text="@string/preset_10" />
                            <Button android:id="@+id/btn_p30" style="@style/Secondary"
                                android:layout_width="0dp" android:layout_weight="1" android:text="@string/preset_30" />
                        </LinearLayout>
                        <View style="@style/Divider" />
                        <CheckBox android:id="@+id/cb_yt" style="@style/Check" android:text="@string/limit_youtube" />
                        <TextView style="@style/Hint" android:text="@string/minutes_label" />
                        <EditText android:id="@+id/et_yt" style="@style/Num" android:hint="30" />
                        <View style="@style/Divider" />
                        <CheckBox android:id="@+id/cb_game" style="@style/Check" android:text="@string/limit_games" />
                        <TextView style="@style/Hint" android:text="@string/minutes_label" />
                        <EditText android:id="@+id/et_game" style="@style/Num" android:hint="30" />
                        <View style="@style/Divider" />
                        <TextView style="@style/FieldLabel" android:text="@string/cooldown_label" />
                        <TextView style="@style/Hint" android:text="@string/cooldown_hint" />
                        <EditText android:id="@+id/et_cooldown" style="@style/Num" android:hint="10" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== الاستثناءات ===== -->
            <Button android:id="@+id/hdr_exclude" style="@style/GroupHeader" android:text="@string/sec_exclude" />
            <LinearLayout android:id="@+id/box_exclude" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/Hint" android:text="@string/exclude_hint" />
                        <CheckBox android:id="@+id/cb_exclude_fb" style="@style/Check" android:text="@string/exclude_fb" />
                        <CheckBox android:id="@+id/cb_exclude_ig" style="@style/Check" android:text="@string/exclude_ig" />
                        <View style="@style/Divider" />
                        <Button android:id="@+id/btn_pick_video" style="@style/Secondary" android:text="@string/pick_video" />
                        <Button android:id="@+id/btn_pick_games" style="@style/Secondary" android:text="@string/pick_games" />
                        <Button android:id="@+id/btn_pick_allowed" style="@style/Secondary" android:text="@string/pick_allowed" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== الأوقات ===== -->
            <Button android:id="@+id/hdr_times" style="@style/GroupHeader" android:text="@string/sec_times" />
            <LinearLayout android:id="@+id/box_times" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <CheckBox android:id="@+id/cb_schedule" style="@style/Check" android:text="@string/schedule_label" />
                        <TextView style="@style/Hint" android:text="@string/schedule_hint" />
                        <Button android:id="@+id/btn_sched_from" style="@style/Secondary" android:text="@string/sched_from" />
                        <Button android:id="@+id/btn_sched_to" style="@style/Secondary" android:text="@string/sched_to" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <CheckBox android:id="@+id/cb_relax" style="@style/Check" android:text="@string/relax_label" />
                        <TextView style="@style/Hint" android:text="@string/relax_hint" />
                        <Button android:id="@+id/btn_relax_days" style="@style/Secondary" android:text="@string/relax_days_btn" />
                        <TextView style="@style/Hint" android:text="@string/relax_limit_label" />
                        <EditText android:id="@+id/et_relax_limit" style="@style/Num" android:hint="60" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <CheckBox android:id="@+id/cb_night" style="@style/Check" android:text="@string/night_label" />
                        <TextView style="@style/Hint" android:text="@string/night_hint" />
                        <Button android:id="@+id/btn_night_from" style="@style/Secondary" android:text="@string/night_from" />
                        <Button android:id="@+id/btn_night_to" style="@style/Secondary" android:text="@string/night_to" />
                        <TextView style="@style/Hint" android:text="@string/night_limit_label" />
                        <EditText android:id="@+id/et_night_limit" style="@style/Num" android:hint="1" />
                        <View style="@style/Divider" />
                        <TextView style="@style/FieldLabel" android:text="@string/night_screen_label" />
                        <TextView style="@style/Hint" android:text="@string/night_screen_hint" />
                        <EditText android:id="@+id/et_night_screen" style="@style/Num" android:hint="0" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== الاستراحة الإجبارية ===== -->
            <Button android:id="@+id/hdr_break" style="@style/GroupHeader" android:text="@string/sec_break" />
            <LinearLayout android:id="@+id/box_break" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/Hint" android:text="@string/break_hint" />
                        <TextView style="@style/FieldLabel" android:text="@string/break_threshold_label" />
                        <EditText android:id="@+id/et_break_threshold" style="@style/Num" android:hint="20" />
                        <TextView style="@style/FieldLabel" android:text="@string/break_minutes_label" android:paddingTop="10dp" />
                        <EditText android:id="@+id/et_break_minutes" style="@style/Num" android:hint="60" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== الإيقاف المؤقت والافتراضي ===== -->
            <Button android:id="@+id/hdr_auto" style="@style/GroupHeader" android:text="@string/sec_auto" />
            <LinearLayout android:id="@+id/box_auto" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/FieldLabel" android:text="@string/resume_label" />
                        <TextView style="@style/Hint" android:text="@string/resume_hint" />
                        <EditText android:id="@+id/et_resume" style="@style/Num" android:hint="30" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- الإعداد الافتراضي القديم: استُبدل بنوع «افتراضي/لحظي» في الأعلى (مخفي) -->
                <androidx.cardview.widget.CardView android:id="@+id/card_revert" style="@style/Card" android:visibility="gone">
                    <LinearLayout style="@style/CardInner">
                        <CheckBox android:id="@+id/cb_revert" style="@style/Check" android:text="@string/revert_label" />
                        <TextView style="@style/Hint" android:text="@string/revert_hint" />
                        <TextView style="@style/FieldLabel" android:text="@string/revert_minutes_label" />
                        <EditText android:id="@+id/et_revert" style="@style/Num" android:hint="30" />
                        <Button android:id="@+id/btn_save_default" style="@style/Secondary" android:text="@string/save_as_default" />
                        <TextView android:id="@+id/tv_default_status" style="@style/Hint" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>


                <Button android:id="@+id/btn_save" style="@style/Primary" android:text="@string/save_send_target" />
                <Button android:id="@+id/btn_remote_unlock" style="@style/Danger" android:text="@string/remote_unlock_target"
                    android:visibility="gone" />
                <Button android:id="@+id/btn_remote_stop" style="@style/Secondary" android:text="@string/remote_stop"
                    android:visibility="gone" />
                <Button android:id="@+id/btn_remote_resume" style="@style/Secondary" android:text="@string/remote_resume"
                    android:visibility="gone" />
                <Button android:id="@+id/btn_back_device2" style="@style/Secondary" android:text="@string/back_device" />
            </LinearLayout>

            <!-- ======== شاشة ٣: إعدادات التطبيق على هذا الجهاز (⚙) ======== -->
            <LinearLayout android:id="@+id/app_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <Button android:id="@+id/btn_back_app" style="@style/Secondary" android:text="@string/back_devices" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/app_settings_title" android:textColor="@color/text"
                    android:textSize="22sp" android:textStyle="bold" android:gravity="center"
                    android:paddingTop="10dp" android:paddingBottom="4dp" />
            <!-- إشعار جهاز الطفل (يظهر عندما يكون الدور = طفل) -->
            <TextView android:id="@+id/tv_child_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/child_locked_notice"
                android:textColor="@color/warn"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="14dp"
                android:background="@drawable/field_bg"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />


            <!-- ===== إعداد هذا الجهاز: الدور والرمز والاسم ===== -->
            <Button android:id="@+id/hdr_remote" style="@style/GroupHeader" android:text="@string/sec_remote" />
            <LinearLayout android:id="@+id/box_remote" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/Hint" android:text="@string/remote_hint" />
                        <RadioGroup android:id="@+id/rg_role"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="6dp" android:paddingBottom="6dp">
                            <RadioButton android:id="@+id/rb_parent" style="@style/Check" android:text="@string/role_parent" />
                            <RadioButton android:id="@+id/rb_child" style="@style/Check" android:text="@string/role_child" />
                        </RadioGroup>
                        <TextView style="@style/FieldLabel" android:text="@string/sync_url_label" />
                        <EditText android:id="@+id/et_sync_url" style="@style/Num"
                            android:inputType="textUri" android:hint="https://xxxx.firebaseio.com" />
                        <TextView style="@style/FieldLabel" android:text="@string/family_label" android:paddingTop="10dp" />
                        <EditText android:id="@+id/et_family" style="@style/Num"
                            android:inputType="textVisiblePassword" />
                        <Button android:id="@+id/btn_gen_code" style="@style/Secondary" android:text="@string/gen_code" />
                        <TextView style="@style/FieldLabel" android:text="@string/device_name_label" android:paddingTop="10dp" />
                        <EditText android:id="@+id/et_device_name" style="@style/Num"
                            android:inputType="textPersonName" />
                        <Button android:id="@+id/btn_save_remote" style="@style/Secondary" android:text="@string/save_remote" />
                        <Button android:id="@+id/btn_sync_now" style="@style/Secondary" android:text="@string/sync_now" />
                        <TextView android:id="@+id/tv_sync_status" style="@style/Status" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== الصلاحيات ===== -->
            <Button android:id="@+id/hdr_perms" style="@style/GroupHeader" android:text="@string/permissions" />
            <LinearLayout android:id="@+id/box_perms" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView android:id="@+id/tv_usage_status" style="@style/Status" />
                        <Button android:id="@+id/btn_usage" style="@style/Secondary" android:text="@string/grant_usage" />
                        <TextView android:id="@+id/tv_overlay_status" style="@style/Status" />
                        <Button android:id="@+id/btn_overlay" style="@style/Secondary" android:text="@string/grant_overlay" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== الحماية من التحايل ===== -->
            <Button android:id="@+id/hdr_protect" style="@style/GroupHeader" android:text="@string/protection_title" />
            <LinearLayout android:id="@+id/box_protect" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/Hint" android:text="@string/protection_hint" />
                        <Button android:id="@+id/btn_restricted" style="@style/Secondary" android:text="@string/grant_restricted" />
                        <TextView android:id="@+id/tv_a11y_status" style="@style/Status" />
                        <Button android:id="@+id/btn_a11y" style="@style/Secondary" android:text="@string/grant_a11y" />
                        <TextView android:id="@+id/tv_notif_status" style="@style/Status" />
                        <Button android:id="@+id/btn_notif" style="@style/Secondary" android:text="@string/grant_notif" />
                        <TextView android:id="@+id/tv_admin_status" style="@style/Status" />
                        <Button android:id="@+id/btn_admin" style="@style/Secondary" android:text="@string/grant_admin" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== وضع البنوك ===== -->
            <Button android:id="@+id/hdr_bank" style="@style/GroupHeader" android:text="@string/sec_bank" />
            <LinearLayout android:id="@+id/box_bank" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView style="@style/Hint" android:text="@string/bank_hint" />
                        <TextView android:id="@+id/tv_bank_status" style="@style/Status" />
                        <Button android:id="@+id/btn_bank_mode" style="@style/Secondary" android:text="@string/bank_pause" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== التشغيل ===== -->
            <Button android:id="@+id/hdr_run" style="@style/GroupHeader" android:text="@string/sec_run" />
            <LinearLayout android:id="@+id/box_run" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <androidx.cardview.widget.CardView style="@style/Card">
                    <LinearLayout style="@style/CardInner">
                        <TextView android:id="@+id/tv_service_status" style="@style/Status" />
                        <Button android:id="@+id/btn_start" style="@style/Primary" android:text="@string/start_monitor" />
                        <Button android:id="@+id/btn_stop" style="@style/Secondary" android:text="@string/stop_monitor" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

                <View style="@style/Divider" />
                <Button android:id="@+id/btn_change_pin" style="@style/Secondary" android:text="@string/change_pin" />
                <Button android:id="@+id/btn_update_app" style="@style/Secondary" android:text="@string/download_latest" />
                <Button android:id="@+id/btn_logout_app" style="@style/Secondary" android:text="@string/logout" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
