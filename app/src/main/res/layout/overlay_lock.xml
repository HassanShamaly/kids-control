<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/lock_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_shield"
        android:contentDescription="@string/app_name"
        app:tint="@color/accent"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/lock_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:text="@string/lock_youtube"
        android:textColor="@color/accent"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="32dp"
        android:text="@string/lock_sub"
        android:textColor="@color/hint"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/quran_btn_bg"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:stateListAnimator="@null"
        android:text="@string/unlock_btn"
        android:textColor="@color/on_accent"
        android:textStyle="bold"
        android:textSize="18sp" />
    <LinearLayout
        android:id="@+id/quran_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/quran_box_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/quran_app_name"
            android:src="@drawable/sohba_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/quran_suggest_title"
            android:textColor="#F5E6C4"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:text="@string/quran_suggest_sub"
            android:textColor="#C9D3CF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_quran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quran_btn_bg"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/quran_open"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pin_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:textColor="@color/accent"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/pin_err"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:textColor="#FF8A80"
            android:textSize="15sp" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/k_1" style="@style/PinKey" android:text="1" />
            <Button android:id="@+id/k_2" style="@style/PinKey" android:text="2" />
            <Button android:id="@+id/k_3" style="@style/PinKey" android:text="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/k_4" style="@style/PinKey" android:text="4" />
            <Button android:id="@+id/k_5" style="@style/PinKey" android:text="5" />
            <Button android:id="@+id/k_6" style="@style/PinKey" android:text="6" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/k_7" style="@style/PinKey" android:text="7" />
            <Button android:id="@+id/k_8" style="@style/PinKey" android:text="8" />
            <Button android:id="@+id/k_9" style="@style/PinKey" android:text="9" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/k_del" style="@style/PinKey" android:text="⌫" />
            <Button android:id="@+id/k_0" style="@style/PinKey" android:text="0" />
            <Button android:id="@+id/k_ok" style="@style/PinKey" android:text="✓" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
